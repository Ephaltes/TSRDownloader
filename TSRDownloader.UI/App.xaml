<Application x:Class="TSRDownloader.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ThemeMode="Light">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Colour palette; ThemeService swaps it for Themes/Dark.xaml -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Glyph from the Windows icon font (Fluent on Windows 11, MDL2 on Windows 10) -->
            <Style x:Key="ToolbarIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <!-- Toolbar button: outlined and quiet like the app's panels; blue only on hover,
                 matching the hover treatment of the settings combo boxes. -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource App.Control}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentPressed}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Status pill that toggles its state: green with a pause glyph while active
                 (Tag = true), orange with a play glyph while paused. Outlined in blue on hover
                 like the toolbar buttons. -->
            <Style x:Key="StatusToggleStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource App.WarningSurface}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Glyph" Text="&#xE768;"
                                               Style="{StaticResource ToolbarIcon}"
                                               Foreground="{DynamicResource App.Text}"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag">
                                    <Trigger.Value>
                                        <sys:Boolean>True</sys:Boolean>
                                    </Trigger.Value>
                                    <Setter Property="Background" Value="{DynamicResource App.SuccessSurface}"/>
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE769;"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Combo boxes: rounded like the settings text boxes; a toolbar combo overrides
                 ComboCornerRadius in its own resources to match the toolbar buttons. -->
            <CornerRadius x:Key="ComboCornerRadius">6</CornerRadius>

            <!-- Dropdown item: rounded with the app's hover/selection blues -->
            <Style x:Key="RoundedComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBd" Background="Transparent"
                                    CornerRadius="4" Margin="4,2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource App.AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource App.AccentPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    
            <!-- Rounded combo box matching the app's text boxes and panel styling -->
            <Style x:Key="RoundedComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource App.Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.InputBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource RoundedComboBoxItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Name="ToggleButton" Focusable="False" ClickMode="Press"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" CornerRadius="{DynamicResource ComboCornerRadius}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                <Path x:Name="Arrow" HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                                      Fill="{DynamicResource App.TextMuted}" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource App.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
    
                                <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="10,0,28,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
    
                                <Popup Name="Popup" Placement="Bottom" Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border x:Name="DropDownBorder"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Margin="0,4,0,0"
                                            Background="{DynamicResource App.Control}" BorderBrush="{DynamicResource App.Border}"
                                            BorderThickness="1" CornerRadius="6"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact combo box sized and coloured like the toolbar buttons -->
            <Style x:Key="ToolbarComboBox" TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBox}">
                <Setter Property="Background" Value="{DynamicResource App.Control}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="26"/>
            </Style>

            <!-- Search box sized and coloured like the toolbar buttons, with a search glyph and
                 its placeholder text in Tag -->
            <Style x:Key="SearchTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource App.Control}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource App.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" CornerRadius="4" BorderThickness="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource ToolbarIcon}"
                                               Foreground="{DynamicResource App.TextMuted}"
                                               Margin="8,0,0,0" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource App.TextMuted}"
                                               Margin="28,0,8,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="24,0,6,0"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rounded button; per-button Background/Foreground can override -->
            <Style x:Key="DialogButton" TargetType="Button">
                <Setter Property="Width" Value="110"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}"/>
                <Setter Property="Background" Value="{DynamicResource App.Accent}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rounded check box in the app's colours: blue border on hover like the combo boxes,
                 filled with the accent when checked -->
            <Style x:Key="SettingCheckBox" TargetType="CheckBox">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Text}"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                        BorderThickness="1" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource App.InputBorder}"
                                        Background="{DynamicResource App.Surface}">
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontSize="10"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{DynamicResource App.OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.Accent}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
