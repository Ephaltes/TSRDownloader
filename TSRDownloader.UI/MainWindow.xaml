<Window x:Class="TSRDownloader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TSRDownloader.UI.ViewModels"
        xmlns:behaviors="clr-namespace:TSRDownloader.UI.Behaviors"
        xmlns:converters="clr-namespace:TSRDownloader.UI.Converters"
        xmlns:localization="clr-namespace:TSRDownloader.UI.Localization"
        mc:Ignorable="d"
        Background="{DynamicResource App.WindowBackground}" Foreground="{DynamicResource App.Text}"
        Title="TSR Downloader"
        Height="550" Width="960"
        MinHeight="400" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <Window.Resources>
        <converters:ColumnWidthToCellWidthConverter x:Key="ColumnWidthToCellWidthConverter"/>

        <!-- Long tooltip text (error messages, links) wraps instead of running off the screen. -->
        <Style TargetType="ToolTip">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="400"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ctrl+V adds the links on the clipboard; a focused text box handles its own paste first. -->
    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteLinksCommand}"/>
    </Window.InputBindings>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Menu bar and the two status toggles -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Menu DockPanel.Dock="Left" Background="Transparent" FontSize="13"
                  VerticalAlignment="Center">
                <MenuItem Header="{localization:Localize Menu_File}">
                    <MenuItem Header="{localization:Localize Menu_Settings}"
                              Command="{Binding OpenSettingsCommand}"/>
                    <Separator/>
                    <MenuItem Header="{localization:Localize Menu_Exit}" Command="{Binding ExitCommand}"/>
                </MenuItem>
                <MenuItem Header="{localization:Localize Menu_Help}">
                    <MenuItem Header="{localization:Localize Menu_About}" Click="OnAboutClick"/>
                </MenuItem>
            </Menu>

            <!-- Each pill shows a state and toggles it: clipboard watching, and downloading.
                 Pausing downloads keeps adding copied links to the list. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ToggleClipboardCommand}" Tag="{Binding IsMonitoring}"
                        ToolTip="{localization:Localize Toolbar_ClipboardHint}"
                        Style="{StaticResource StatusToggleStyle}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{localization:Localize Main_Status_Monitoring}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                        <Setter Property="Text" Value="{localization:Localize Main_Status_Paused}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Command="{Binding ToggleDownloadsCommand}" Tag="{Binding IsDownloading}"
                        ToolTip="{localization:Localize Toolbar_DownloadsHint}"
                        Style="{StaticResource StatusToggleStyle}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{localization:Localize Main_Status_Downloading}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloading}" Value="False">
                                        <Setter Property="Text" Value="{localization:Localize Main_Status_DownloadsPaused}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Row 1: Toolbar (actions on the list) -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*" MaxWidth="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RetryFailedCommand}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource ToolbarIcon}"/>
                        <TextBlock Text="{localization:Localize Toolbar_RetryFailed}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearFinishedCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource ToolbarIcon}"/>
                        <TextBlock Text="{localization:Localize Toolbar_ClearFinished}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenDownloadFolderCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource ToolbarIcon}"/>
                        <TextBlock Text="{localization:Localize Toolbar_OpenFolder}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Filter and order of the list; the search box gives way when the window is narrow -->
            <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{localization:Localize Toolbar_Search}" Margin="12,0,0,0"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                     Style="{StaticResource SearchTextBox}"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                      ToolTip="{localization:Localize Toolbar_SortHint}" Width="140" Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToolbarComboBox}">
                <ComboBox.Resources>
                    <CornerRadius x:Key="ComboCornerRadius">4</CornerRadius>
                </ComboBox.Resources>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Row 2: Download List with resizable columns -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                CornerRadius="6">
            <Grid>
            <ListView x:Name="DownloadList"
                      ItemsSource="{Binding DownloadItemsView}"
                      SelectionChanged="OnSelectionChanged"
                      BorderThickness="0" Background="{DynamicResource App.WindowBackground}"
                      behaviors:GridViewColumnSizing.Fill="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionMode="Extended">

                <ListView.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveCommand}"/>
                </ListView.InputBindings>

                <!-- Right-clicking a row selects it; the commands act on all selected rows. -->
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{localization:Localize Context_Retry}" Command="{Binding RetryCommand}"/>
                        <MenuItem Header="{localization:Localize Context_Open}" Command="{Binding OpenCommand}"/>
                        <MenuItem Header="{localization:Localize Context_ShowInFolder}" Command="{Binding ShowInFolderCommand}"/>
                        <MenuItem Header="{localization:Localize Context_OpenOnTsr}" Command="{Binding OpenOnTsrCommand}"/>
                        <MenuItem Header="{localization:Localize Context_CopyUrl}" Command="{Binding CopyUrlsCommand}"/>
                        <Separator/>
                        <MenuItem Header="{localization:Localize Context_Remove}" Command="{Binding RemoveCommand}"
                                  InputGestureText="Del"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.View>
                    <!-- Fixed columns keep their width; star-weighted columns share the
                         remaining width and resize with the window (see GridViewColumnSizing). -->
                    <GridView>
                        <!-- Status Column (fixed) -->
                        <GridViewColumn Width="64">
                            <GridViewColumn.Header>
                                <TextBlock Text="{localization:Localize Column_Status}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource App.TextSecondary}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusIcon}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="{Binding StatusColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding StatusText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Item ID Column (fixed) -->
                        <GridViewColumn Width="70">
                            <GridViewColumn.Header>
                                <TextBlock Text="{localization:Localize Column_Id}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource App.TextSecondary}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemId}"
                                               FontSize="11" Foreground="{DynamicResource App.TextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- FileName Column (fills) -->
                        <GridViewColumn Width="350" behaviors:GridViewColumnSizing.StarWeight="2">
                            <GridViewColumn.Header>
                                <TextBlock Text="{localization:Localize Column_FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource App.TextSecondary}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding FileName}"
                                               Margin="5,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- URL Column (fills) -->
                        <GridViewColumn Width="220" behaviors:GridViewColumnSizing.StarWeight="3">
                            <GridViewColumn.Header>
                                <TextBlock Text="{localization:Localize Column_Url}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource App.TextSecondary}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="5,0">
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding CopyUrlToClipboardCommand}"/>
                                        </StackPanel.InputBindings>
                                        <TextBlock Text="{Binding Url}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Url}"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11" Foreground="{DynamicResource App.TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Progress Column (fills) -->
                        <GridViewColumn Width="260" behaviors:GridViewColumnSizing.StarWeight="2">
                            <GridViewColumn.Header>
                                <TextBlock Text="{localization:Localize Column_Progress}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource App.TextSecondary}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- GridView never stretches cell content, so we size the cell
                                         to the progress column's own Width (Columns[4]) via the
                                         parent ListView. This fills the column and tracks resizing. -->
                                    <!-- A failed item's error is often cut off; hovering shows all of it. -->
                                    <Grid Width="{Binding View.Columns[4].Width, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, Converter={StaticResource ColumnWidthToCellWidthConverter}}"
                                          ToolTip="{Binding ErrorToolTip}" ToolTipService.ShowDuration="30000">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ProgressBar Grid.Row="0"
                                                     Height="22"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding Progress}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Foreground="{Binding StatusColor}"
                                                     Background="{DynamicResource App.ProgressTrack}"
                                                     BorderThickness="0"
                                                     Margin="8,4,8,2"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding ProgressText}"
                                                   FontSize="11" Foreground="{DynamicResource App.TextSecondary}"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,2"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Height" Value="54"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource App.Divider}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0">
                                        <GridViewRowPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              Margin="6,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource App.AccentHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Empty state: explains how to start, since the app has no "add" button -->
            <TextBlock Text="{localization:Localize Main_EmptyHint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                       FontSize="14" Foreground="{DynamicResource App.TextMuted}" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DownloadItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
        </Border>

        <!-- Row 3: Overall Progress -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,8"
                Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{localization:Localize Overall_Total}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ProgressBar Grid.Column="1" Height="16"
                             Minimum="0" Maximum="100"
                             Value="{Binding OverallProgress}"
                             Background="{DynamicResource App.ProgressTrack}"
                             Foreground="{DynamicResource App.Success}"
                             BorderThickness="0"
                             VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="13">
                    <Run Text="{Binding FinishedCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalCount}"/>
                    <Run Text=" "/><Run Text="{localization:Localize Overall_Done}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Row 4: Status Bar -->
        <Border Grid.Row="4" Margin="0,8,0,0" Padding="10,4"
                Background="{DynamicResource App.SurfaceAlt}" CornerRadius="4">
            <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}"
                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12" Foreground="{DynamicResource App.TextSecondary}">
                    <Run Text="{localization:Localize StatusBar_Queue}"/>
                    <Run Text="{Binding QueuedCount, StringFormat={} {0}}" FontWeight="SemiBold"/>
                </TextBlock>
                <Separator Width="1" Margin="15,2" Background="{DynamicResource App.InputBorder}"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource App.Accent}">
                    <Run Text="{localization:Localize StatusBar_Active}"/>
                    <Run Text="{Binding ActiveCount, StringFormat={} {0}}" FontWeight="SemiBold"/>
                </TextBlock>
                <Separator Width="1" Margin="15,2" Background="{DynamicResource App.InputBorder}"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource App.Extracting}">
                    <Run Text="{localization:Localize StatusBar_Extracting}"/>
                    <Run Text="{Binding ExtractingCount, StringFormat={} {0}}" FontWeight="SemiBold"/>
                </TextBlock>
                <Separator Width="1" Margin="15,2" Background="{DynamicResource App.InputBorder}"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource App.Error}">
                    <Run Text="{localization:Localize StatusBar_Errors}"/>
                    <Run Text="{Binding ErrorCount, StringFormat={} {0}}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
