<Window x:Class="TSRDownloader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TSRDownloader.UI.ViewModels"
        xmlns:behaviors="clr-namespace:TSRDownloader.UI.Behaviors"
        xmlns:conv="clr-namespace:TSRDownloader.UI.Converters"
        xmlns:loc="clr-namespace:TSRDownloader.UI.Localization"
        mc:Ignorable="d"
        Title="TSR Downloader"
        Height="550" Width="960"
        MinHeight="400" MinWidth="860"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ColumnWidthToCellWidthConverter x:Key="ColumnWidthToCellWidthConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Menu bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Menu DockPanel.Dock="Left" Background="Transparent" FontSize="13"
                  VerticalAlignment="Center">
                <MenuItem Header="{loc:Loc Menu_File}">
                    <MenuItem Header="{loc:Loc Menu_Settings}"
                              Command="{Binding OpenSettingsCommand}"/>
                    <Separator/>
                    <MenuItem Header="{loc:Loc Menu_Exit}" Command="{Binding ExitCommand}"/>
                </MenuItem>
                <MenuItem Header="{loc:Loc Menu_Help}">
                    <MenuItem Header="{loc:Loc Menu_About}" Click="OnAboutClick"/>
                </MenuItem>
            </Menu>

            <!-- Monitoring Status Indicator -->
            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,4"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#E8F5E9"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                <Setter Property="Background" Value="#FFF3E0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{loc:Loc Main_Status_Monitoring}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                    <Setter Property="Text" Value="{loc:Loc Main_Status_Paused}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- Toolbar: quiet outlined buttons sized like the status pill next to them -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Command="{Binding ToggleMonitoringCommand}"
                        ToolTip="{loc:Loc Toolbar_PauseHint}"
                        Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ToolbarIcon}">
                                    <Setter Property="Text" Value="&#xE769;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                            <Setter Property="Text" Value="&#xE768;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{loc:Loc Toolbar_Pause}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                            <Setter Property="Text" Value="{loc:Loc Toolbar_Resume}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearFinishedCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource ToolbarIcon}"/>
                        <TextBlock Text="{loc:Loc Toolbar_ClearFinished}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenDownloadFolderCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource ToolbarIcon}"/>
                        <TextBlock Text="{loc:Loc Toolbar_OpenFolder}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Row 1: Download List with resizable columns -->
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="6">
            <Grid>
            <ListView ItemsSource="{Binding DownloadItems}"
                      SelectedItem="{Binding SelectedItem}"
                      BorderThickness="0"
                      behaviors:GridViewColumnSizing.Fill="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                       SelectionMode="Single">

                <ListView.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveCommand}"/>
                </ListView.InputBindings>

                <!-- Right-clicking a row selects it, so the commands act on SelectedItem. -->
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc Context_Retry}" Command="{Binding RetryCommand}"/>
                        <MenuItem Header="{loc:Loc Context_ShowInFolder}" Command="{Binding ShowInFolderCommand}"/>
                        <MenuItem Header="{loc:Loc Context_CopyUrl}"
                                  Command="{Binding SelectedItem.CopyUrlToClipboardCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc Context_Remove}" Command="{Binding RemoveCommand}"
                                  InputGestureText="Del"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.View>
                    <!-- Fixed columns keep their width; star-weighted columns share the
                         remaining width and resize with the window (see GridViewColumnSizing). -->
                    <GridView>
                        <!-- Status Column (fixed) -->
                        <GridViewColumn Width="55">
                            <GridViewColumn.Header>
                                <TextBlock Text="{loc:Loc Column_Status}" FontWeight="SemiBold" FontSize="12" Foreground="#555"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusIcon}"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding StatusText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Item ID Column (fixed) -->
                        <GridViewColumn Width="70">
                            <GridViewColumn.Header>
                                <TextBlock Text="{loc:Loc Column_Id}" FontWeight="SemiBold" FontSize="12" Foreground="#555"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemId}"
                                               FontSize="11" Foreground="#888"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- FileName Column (fills) -->
                        <GridViewColumn Width="350" behaviors:GridViewColumnSizing.StarWeight="2">
                            <GridViewColumn.Header>
                                <TextBlock Text="{loc:Loc Column_FileName}" FontWeight="SemiBold" FontSize="12" Foreground="#555"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding FileName}"
                                               Margin="5,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- URL Column (fills) -->
                        <GridViewColumn Width="220" behaviors:GridViewColumnSizing.StarWeight="3">
                            <GridViewColumn.Header>
                                <TextBlock Text="{loc:Loc Column_Url}" FontWeight="SemiBold" FontSize="12" Foreground="#555"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="5,0">
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding CopyUrlToClipboardCommand}"/>
                                        </StackPanel.InputBindings>
                                        <TextBlock Text="{Binding Url}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Url}"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11" Foreground="#888"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Progress Column (fills) -->
                        <GridViewColumn Width="260" behaviors:GridViewColumnSizing.StarWeight="2">
                            <GridViewColumn.Header>
                                <TextBlock Text="{loc:Loc Column_Progress}" FontWeight="SemiBold" FontSize="12" Foreground="#555"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- GridView never stretches cell content, so we size the cell
                                         to the progress column's own Width (Columns[4]) via the
                                         parent ListView. This fills the column and tracks resizing. -->
                                    <Grid Width="{Binding View.Columns[4].Width, RelativeSource={RelativeSource AncestorType={x:Type ListView}}, Converter={StaticResource ColumnWidthToCellWidthConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ProgressBar Grid.Row="0"
                                                     Height="22"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding Progress}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Foreground="{Binding StatusColor}"
                                                     Background="#E8E8E8"
                                                     BorderThickness="0"
                                                     Margin="8,4,8,2"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding ProgressText}"
                                                   FontSize="11" Foreground="#666"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,2"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Height" Value="54"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#F0F0F0"
                                            BorderThickness="0,0,0,1"
                                            Padding="0">
                                        <GridViewRowPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              Margin="6,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="#F0F7FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Empty state: explains how to start, since the app has no "add" button -->
            <TextBlock Text="{loc:Loc Main_EmptyHint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                       FontSize="14" Foreground="#888" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DownloadItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
        </Border>

        <!-- Row 2: Overall Progress -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8"
                Background="#FAFAFA" BorderBrush="#E0E0E0"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{loc:Loc Overall_Total}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ProgressBar Grid.Column="1" Height="16"
                             Minimum="0" Maximum="100"
                             Value="{Binding OverallProgress}"
                             Background="#E8E8E8"
                             Foreground="#4CAF50"
                             BorderThickness="0"
                             VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="13">
                    <Run Text="{Binding CompletedCount}"/><Run Text=" + "/>
                    <Run Text="{Binding FailedCount}" Foreground="#F44336"/>
                    <Run Text=" / "/><Run Text="{Binding TotalCount}"/>
                    <Run Text=" "/><Run Text="{loc:Loc Overall_Done}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Row 3: Status Bar -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="10,4"
                Background="#F5F5F5" CornerRadius="4">
            <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}"
                       FontSize="12" Foreground="#999" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12" Foreground="#666">
                    <Run Text="{loc:Loc StatusBar_Queue}"/>
                    <Run Text="{Binding QueuedCount, StringFormat={} {0}}" FontWeight="SemiBold"/>
                </TextBlock>
                <Separator Width="1" Margin="15,2" Background="#CCC"/>
                <TextBlock FontSize="12" Foreground="#2196F3">
                    <Run Text="{loc:Loc StatusBar_Active}"/>
                    <Run Text="{Binding ActiveCount, StringFormat={} {0}}" FontWeight="SemiBold"/>
                </TextBlock>
                <Separator Width="1" Margin="15,2" Background="#CCC"/>
                <TextBlock FontSize="12" Foreground="#F44336">
                    <Run Text="{loc:Loc StatusBar_Errors}"/>
                    <Run Text="{Binding FailedCount, StringFormat={} {0}}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
