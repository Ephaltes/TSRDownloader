<!-- Dark palette; same keys as Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="App.WindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="App.Surface" Color="#252525"/>
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="App.Control" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="App.SecondaryButton" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="App.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="App.InputBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="App.Divider" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="App.Text" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="App.TextSecondary" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="App.TextMuted" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="App.Accent" Color="#3FA2F5"/>
    <SolidColorBrush x:Key="App.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.AccentHover" Color="#1D2D3D"/>
    <SolidColorBrush x:Key="App.AccentPressed" Color="#233A52"/>
    <SolidColorBrush x:Key="App.Error" Color="#F6685E"/>
    <SolidColorBrush x:Key="App.Success" Color="#5CBF60"/>
    <SolidColorBrush x:Key="App.ProgressTrack" Color="#383838"/>
    <SolidColorBrush x:Key="App.SuccessSurface" Color="#1E3523"/>
    <SolidColorBrush x:Key="App.WarningSurface" Color="#3D2F17"/>
</ResourceDictionary>
