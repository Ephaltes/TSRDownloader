<Window x:Class="TSRDownloader.UI.Views.FileConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TSRDownloader.UI.Localization"
        Title="{loc:Loc Conflict_Title}"
        Width="440" SizeToContent="Height"
        MinHeight="180" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0"
                   TextWrapping="Wrap" FontSize="13" Foreground="#333"/>

        <CheckBox x:Name="ApplyToAllCheckBox" Grid.Row="1"
                  Content="{loc:Loc Conflict_ApplyToAll}"
                  Margin="0,16,0,0" FontSize="13" Foreground="#333"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Loc Conflict_Skip}"
                    Click="OnSkip" IsCancel="True"
                    Width="120" Height="34" Margin="8,0,0,0"/>
            <Button Content="{loc:Loc Conflict_Overwrite}"
                    Click="OnOverwrite" IsDefault="True"
                    Width="120" Height="34" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
