<Window x:Class="TSRDownloader.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TSRDownloader.UI.ViewModels"
        xmlns:loc="clr-namespace:TSRDownloader.UI.Localization"
        xmlns:converters="clr-namespace:TSRDownloader.UI.Converters"
        mc:Ignorable="d"
        Title="{loc:Loc Settings_Title}"
        Height="600" Width="540"
        MinHeight="600" MinWidth="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <!-- Rounded text box matching the app's panel styling -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded button; per-button Background/Foreground can override -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dropdown item: rounded with the app's hover/selection blues -->
        <Style x:Key="RoundedComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="Transparent"
                                CornerRadius="4" Margin="4,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded combo box matching the app's text boxes and panel styling -->
        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RoundedComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="6"
                                                Background="#FAFAFA"
                                                BorderBrush="#CCC" BorderThickness="1">
                                            <Path x:Name="Arrow" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Fill="#777" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#2196F3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup Name="Popup" Placement="Bottom" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Background="White" BorderBrush="#E0E0E0"
                                        BorderThickness="1" CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat tab header: grey text, blue text + underline when selected -->
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,3"
                                Padding="14,8" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,12,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card holding the settings of one tab -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,4,16,16"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource SettingsTabControl}">
            <!-- General -->
            <TabItem Header="{loc:Loc Settings_Tab_General}">
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_Language}" Style="{StaticResource SettingLabel}"/>
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  HorizontalAlignment="Left" Width="160"
                                  Style="{StaticResource RoundedComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox Content="{loc:Loc Settings_NotifyOnLink}"
                                  IsChecked="{Binding NotifyOnLinkFound}"
                                  Style="{StaticResource SettingCheckBox}"
                                  Margin="0,16,0,0"/>

                        <CheckBox Content="{loc:Loc Settings_StartOnStartup}"
                                  IsChecked="{Binding StartOnSystemStartup}"
                                  Style="{StaticResource SettingCheckBox}"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Downloads -->
            <TabItem Header="{loc:Loc Settings_Tab_Downloads}">
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_DownloadDirectory}" Style="{StaticResource SettingLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDownloadDirectoryError}" Value="True">
                                                <Setter Property="BorderBrush" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <Button Grid.Column="1" Content="{loc:Loc Settings_Browse}"
                                    Command="{Binding BrowseDownloadDirectoryCommand}"
                                    Width="130"
                                    Style="{StaticResource DialogButton}"/>
                        </Grid>
                        <TextBlock Text="{Binding DownloadDirectoryError}"
                                   Style="{StaticResource SettingHint}" Foreground="#F44336"
                                   Visibility="{Binding HasDownloadDirectoryError, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{loc:Loc Settings_MaxDownloads}" Style="{StaticResource SettingLabel}"/>
                        <TextBox x:Name="MaxDownloadsTextBox"
                                 Text="{Binding MaxActiveDownloads, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left" Width="80"
                                 Style="{StaticResource RoundedTextBox}"
                                 PreviewTextInput="MaxDownloadsTextBox_PreviewTextInput"/>

                        <TextBlock Text="{loc:Loc Settings_TicketDelay}" Style="{StaticResource SettingLabel}"/>
                        <TextBox x:Name="TicketDelayTextBox"
                                 Text="{Binding TicketActivationDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left" Width="80"
                                 Style="{StaticResource RoundedTextBox}"
                                 PreviewTextInput="TicketDelayTextBox_PreviewTextInput"/>
                        <TextBlock Text="{loc:Loc Settings_TicketDelayHint}" Style="{StaticResource SettingHint}"/>

                        <CheckBox Content="{loc:Loc Settings_ExtractZip}"
                                  IsChecked="{Binding ExtractZipArchives}"
                                  Style="{StaticResource SettingCheckBox}"
                                  Margin="0,16,0,0"/>

                        <CheckBox Content="{loc:Loc Settings_DeleteZipAfterExtract}"
                                  IsChecked="{Binding DeleteZipAfterExtraction}"
                                  IsEnabled="{Binding ExtractZipArchives}"
                                  Style="{StaticResource SettingCheckBox}"
                                  Margin="20,8,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Updates -->
            <TabItem Header="{loc:Loc Settings_Tab_Updates}">
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_Updates}" Style="{StaticResource SettingLabel}"/>
                        <ComboBox ItemsSource="{Binding UpdateModes}"
                                  SelectedItem="{Binding SelectedUpdateMode}"
                                  HorizontalAlignment="Left" Width="220"
                                  Style="{StaticResource RoundedComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource SettingHint}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Buttons (save/cancel apply to all tabs) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Settings_Cancel}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DialogButton}"
                    Background="#E0E0E0" Foreground="#333"/>

            <Button Content="{loc:Loc Settings_Save}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource DialogButton}"
                    Background="#2196F3" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
